{
  "name": "channel-tv",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "dev:worker": "npm run build && npx wrangler dev",
    "deploy:worker": "npm run build && npx wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sync": "node scripts/sync-tv.mjs",
    "sync:popular": "node scripts/sync-popular.mjs",
    "sync:iptv": "node scripts/sync-iptv-source.mjs",
    "catalog": "node scripts/build-discovery.mjs",
    "prebuild": "npm run catalog"
  },
  "dependencies": {
    "i18n-iso-countries": "7.14.0",
    "lucide-react": "^1.57.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "video.js": "^8.24.2"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
